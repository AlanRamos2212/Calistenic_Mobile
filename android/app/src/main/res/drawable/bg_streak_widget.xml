<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget de racha: degradado oscuro con esquinas redondeadas
     y borde sutil, acorde al tema oscuro de CalisthenicTrack. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#232E5C"
        android:centerColor="#121A33"
        android:endColor="#0A1220"
        android:type="linear" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="#22FFFFFF" />
</shape>
