<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo nativo (no Flutter) para ajustar la opacidad del widget de racha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_opacity_dialog"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_opacity_title"
        android:textColor="#10233D"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_opacity_hint"
        android:textColor="#5A6B80"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/opacity_value_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/widget_opacity_value"
        android:textColor="#E07B1A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/opacity_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/opacity_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_opacity_save" />

        <Button
            android:id="@+id/opacity_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/widget_opacity_cancel" />
    </LinearLayout>

    <Button
        android:id="@+id/opacity_open_app"
        style="?android:attr/buttonBarButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_opacity_open_app" />
</LinearLayout>
